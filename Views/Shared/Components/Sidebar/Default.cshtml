@model List<ReportHub_V2.ViewModels.SidebarViewModel>

@{
    var groupedModules = Model
        .GroupBy(x => x.ModuleName)
        .ToList();
}

<style>

    /* =========================================
       SIDEBAR WRAPPER
    ========================================= */

    .sidebar-wrapper {
        width: 250px;
        height: 100vh;
        position: fixed;
        top: 0;
        left: 0;
        z-index: 1000;
        transition: transform .3s ease;
    }

    .sidebar {
        width: 250px;
        height: 100%;
        display: flex;
        flex-direction: column;
        background: linear-gradient( 180deg, #102c46 0%, #124b68 55%, #087e83 100% );
        overflow-x: hidden;
        overflow-y: auto;
        box-shadow: 4px 0 18px rgba(16,44,70,.15);
    }

    /* =========================================
       HIDE SIDEBAR
    ========================================= */

    body.sidebar-hidden .sidebar-wrapper {
        transform: translateX(-100%);
    }

    /* =========================================
       BRAND
    ========================================= */

    .brand {
        text-align: center;
        padding: 18px 10px 15px;
        color: white;
        border-bottom: 1px solid rgba(255,255,255,.15);
    }

        .brand img {
            width: 160px;
            height: 40px;
            object-fit: contain;
        }

    .brand-title {
        margin-top: 7px;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: 1.5px;
        color: #8de3df;
    }

    /* =========================================
       MODULE BUTTON
    ========================================= */

    .module-button {
        width: calc(100% - 20px);
        margin: 3px 10px;
        padding: 11px 13px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: none;
        border-radius: 7px;
        background: transparent;
        color: #ffffff;
        font-size: 13px;
        text-align: left;
        cursor: pointer;
        transition: .25s;
    }

        .module-button:hover,
        .module-button.active {
            background: rgba(255,255,255,.14);
            color: white;
        }

    .module-left {
        display: flex;
        align-items: center;
        gap: 11px;
        min-width: 0;
    }

    .module-icon {
        color: #8de3df;
        font-size: 17px;
        min-width: 20px;
    }

    .module-arrow {
        font-size: 12px;
        transition: transform .25s;
    }

    .module-button.active .module-arrow {
        transform: rotate(180deg);
    }

    /* =========================================
       SUBMENU
    ========================================= */

    .submenu {
        max-height: 0;
        overflow: hidden;
        transition: max-height .3s ease;
        background: rgba(0,0,0,.16);
        margin: 0 10px;
        border-radius: 7px;
    }

        .submenu.show {
            max-height: 1000px;
        }

        .submenu a {
            display: flex;
            align-items: center;
            padding: 11px 12px 11px 43px;
            color: #ffffff !important;
            font-size: 12px;
            font-weight: 500;
            text-decoration: none;
            transition: .2s;
            border-left: 3px solid transparent;
        }

            .submenu a span {
                color: #ffffff !important;
            }

            .submenu a i {
                color: #8de3df !important;
                margin-right: 9px;
                font-size: 10px;
            }

            .submenu a:hover {
                background: rgba(141,227,223,.18);
                border-left-color: #8de3df;
                padding-left: 48px;
            }

    /* =========================================
       MODULE AREA
    ========================================= */

    .sidebar-menu {
        flex: 1;
        padding-top: 8px;
    }

    /* =========================================
       LOGOUT
    ========================================= */

    .logout-section {
        padding: 12px 10px 18px;
        border-top: 1px solid rgba(255,255,255,.15);
        margin-top: auto;
    }

    .logout-btn {
        width: 100%;
        padding: 11px 13px;
        display: flex;
        align-items: center;
        gap: 11px;
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 7px;
        background: rgba(255,255,255,.08);
        color: white;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: .25s;
    }

        .logout-btn i {
            font-size: 17px;
            color: #ffb4b4;
        }

        .logout-btn:hover {
            background: rgba(220,53,69,.85);
            border-color: #dc3545;
        }

    /* =========================================
       SCROLLBAR
    ========================================= */

    .sidebar::-webkit-scrollbar {
        width: 5px;
    }

    .sidebar::-webkit-scrollbar-thumb {
        background: rgba(255,255,255,.25);
        border-radius: 10px;
    }

    .sidebar::-webkit-scrollbar-track {
        background: transparent;
    }

    /* =========================================
       MOBILE RESPONSIVE
    ========================================= */

    @@media (max-width: 767px) {

        .sidebar-wrapper {
            width: 250px;
        }

        .sidebar {
            width: 250px;
        }

        .brand img {
            max-width: 145px;
        }

        .module-button {
            padding: 12px;
        }

        .submenu a {
            padding-top: 12px;
            padding-bottom: 12px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .sidebar-wrapper,
        .module-button,
        .submenu {
            transition: none;
        }
    }

</style>


<!-- =========================================
     SIDEBAR
========================================= -->

<div class="sidebar-wrapper">

    <div class="sidebar" id="reportSidebar">

        <!-- BRAND -->

        <div class="brand">

            <img src="@Url.Content("~/images/cotton_logo.png")"
                 alt="Cotton Club Logo" />

            <div class="brand-title">
                REPORT HUB
            </div>

        </div>


        <!-- MODULES -->

        <div class="sidebar-menu">

            @for (int i = 0; i < groupedModules.Count; i++)
            {
                var module = groupedModules[i];
                var moduleId = "module_" + i;

                <button type="button"
                        class="module-button"
                        data-target="@moduleId"
                        aria-expanded="false">

                    <span class="module-left">

                        <i class="bi @(module.Key.ToLower().Contains("report")
                                                       ? "bi-file-earmark-bar-graph"
                                                       : module.Key.ToLower().Contains("setting")
                                                           ? "bi-gear-fill"
                                                           : "bi-folder2-open") module-icon"></i>

                    <span>@module.Key</span>

                    </span>

                    <i class="bi bi-chevron-down module-arrow"></i>

                </button>


                <!-- SUBMENU -->

                <div class="submenu" id="@moduleId">

                @foreach (var menu in module)
                    {
                        <a href="@Url.Content(menu.Url)"
                           data-menu-id="@menu.MenuId">

                            <i class="bi bi-circle-fill"></i>

                            <span>@menu.MenuName</span>

                        </a>
                    }

                </div>
            }

        </div>


        <!-- LOGOUT -->

        <div class="logout-section">

            <form asp-controller="Account"
                  asp-action="Logout"
                  method="post">

                @Html.AntiForgeryToken()

                <button type="submit" class="logout-btn">

                    <i class="bi bi-box-arrow-right"></i>

                    <span>Logout</span>

                </button>

            </form>

        </div>

    </div>

</div>


<!-- =========================================
     MODULE JAVASCRIPT
========================================= -->

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const moduleButtons = document.querySelectorAll(".module-button");

        moduleButtons.forEach(function (button) {

            button.addEventListener("click", function () {

                const targetId = button.getAttribute("data-target");
                const targetMenu = document.getElementById(targetId);

                if (!targetMenu) return;

                const isAlreadyOpen = targetMenu.classList.contains("show");

                // Close all submenus
                document.querySelectorAll(".submenu").forEach(function (menu) {
                    menu.classList.remove("show");
                });

                // Reset all buttons
                moduleButtons.forEach(function (btn) {
                    btn.classList.remove("active");
                    btn.setAttribute("aria-expanded", "false");
                });

                // Open selected submenu
                if (!isAlreadyOpen) {

                    targetMenu.classList.add("show");

                    button.classList.add("active");

                    button.setAttribute("aria-expanded", "true");

                }

            });

        });

    });

</script>
