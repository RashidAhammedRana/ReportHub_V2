
<!DOCTYPE html>
<html>
<head>

    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>@ViewBag.Title</title>

    <!-- =====================================
         CSS LIBRARIES
    ====================================== -->
    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <!-- Bootstrap Icons -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css"
          rel="stylesheet" />

    <!-- DevExpress Theme -->
    <link href="https://cdn3.devexpress.com/jslib/23.2.6/css/dx.light.css"
          rel="stylesheet" />

    <!-- Toastr CSS -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.css"
          rel="stylesheet" />

    <!-- DevExpress Viewer CSS -->
    <link href="~/css/viewer.part.bundle.css"
          rel="stylesheet"
          asp-append-version="true" />


    <!-- =====================================
         CUSTOM STYLES
    ====================================== -->

    <style>

        * {
            box-sizing: border-box;
        }

        html, body {
            margin: 0;
            padding: 0;
            min-height: 100%;
            width: 100%;
        }

        body {
            background: #f4f6f9;
            overflow-x: hidden;
        }


        /* =====================================
                   SIDEBAR
                ====================================== */

        .sidebar-wrapper {
            width: 250px;
            height: 100vh;
            position: fixed;
            top: 0;
            left: 0;
            overflow-y: auto;
            z-index: 1000;
            transition: transform .3s ease;
        }

        /* Hide Sidebar */

        body.sidebar-hidden .sidebar-wrapper {
            transform: translateX(-100%);
        }


        /* =====================================
                   MAIN CONTENT
                ====================================== */

        .main-content {
            margin-left: 250px;
            padding: 20px;
            min-height: 100vh;
            transition: margin-left .3s ease;
        }

        body.sidebar-hidden .main-content {
            margin-left: 0;
        }


        /* =====================================
                   SIDEBAR TOGGLE BUTTON
                ====================================== */

        .sidebar-toggle {
            position: fixed;
            top: 19px;
            left: 8px;
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            background: #102c46;
            color: #ffffff;
            border: 1px solid rgba(255,255,255,.2);
            border-radius: 6px;
            font-size: 20px;
            cursor: pointer;
            z-index: 2000;
            transition: background .2s ease;
        }

            .sidebar-toggle:hover {
                background: #087e83;
                color: #ffffff;
            }

            .sidebar-toggle:focus-visible {
                outline: 3px solid #8de3df;
                outline-offset: 2px;
            }


        /* =====================================
                   GLOBAL LOADING OVERLAY
                ====================================== */

        #globalLoader {
            display: none;
            position: fixed;
            inset: 0;
            width: 100%;
            height: 100%;
            background: rgba(255,255,255,.65);
            z-index: 999999;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            gap: 12px;
        }

        .loader-spinner {
            width: 45px;
            height: 45px;
            border: 5px solid #ddd;
            border-top: 5px solid #0d6efd;
            border-radius: 50%;
            animation: loaderSpin .8s linear infinite;
        }

        .loader-text {
            font-size: 14px;
            font-weight: 600;
            color: #333;
        }

        @@keyframes loaderSpin {

            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }


        /* =====================================
                   RESPONSIVE
                ====================================== */

        @@media(max-width: 768px) {

            .sidebar-wrapper {
                width: 250px;
            }

            .main-content {
                margin-left: 0;
                padding: 12px;
            }
        }


        /* =====================================
                   REDUCE MOTION
                ====================================== */

        @@media(prefers-reduced-motion: reduce) {

            .sidebar-wrapper,
            .main-content,
            .sidebar-toggle {
                transition: none;
            }

            .loader-spinner {
                animation-duration: 2s;
            }
        }

    </style>


    <!-- =====================================
         JAVASCRIPT LIBRARIES
    ====================================== -->
    <!-- JQuery -->
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <!-- Toastr JS -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/toastr.js/latest/toastr.min.js"></script>

    <!-- DevExpress Third Party -->
    <script src="~/js/thirdparty.bundle.js"
            asp-append-version="true"></script>

</head>


<body>


    <!-- =====================================
         GLOBAL LOADER
    ====================================== -->

    <div id="globalLoader">

        <div class="loader-spinner"></div>

        <div class="loader-text">
            Generating Report... Please Wait
        </div>

    </div>


    <!-- =====================================
         SIDEBAR TOGGLE BUTTON
         ALWAYS VISIBLE
    ====================================== -->

    <button type="button"
            id="sidebarToggle"
            class="sidebar-toggle"
            title="Hide Sidebar"
            aria-label="Hide Sidebar"
            aria-expanded="true">

        <i class="bi bi-list"></i>

    </button>


    <!-- =====================================
         SIDEBAR COMPONENT
    ====================================== -->

    <div class="sidebar-wrapper">

        @await Component.InvokeAsync("Sidebar")

    </div>


    <!-- =====================================
         MAIN CONTENT
    ====================================== -->

    <div class="main-content">

        @RenderBody()

    </div>


    <!-- =====================================
         BOOTSTRAP JS
    ====================================== -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>


    <!-- =====================================
         DEVEXPRESS VIEWER JS
    ====================================== -->

    <script src="~/js/viewer.part.bundle.js"
            asp-append-version="true"></script>


    <!-- =====================================
         GLOBAL JAVASCRIPT
    ====================================== -->

    <script>

        $(function () {


            // =====================================
            // SIDEBAR TOGGLE
            // =====================================

            const toggleBtn = document.getElementById("sidebarToggle");

            if (toggleBtn) {

                const toggleIcon = toggleBtn.querySelector("i");

                toggleBtn.addEventListener("click", function () {

                    document.body.classList.toggle("sidebar-hidden");

                    const isHidden =
                        document.body.classList.contains("sidebar-hidden");

                    // Update Icon
                    if (toggleIcon) {

                        toggleIcon.className = isHidden
                            ? "bi bi-layout-sidebar"
                            : "bi bi-list";

                    }

                    // Update Tooltip
                    toggleBtn.setAttribute(
                        "title",
                        isHidden ? "Show Sidebar" : "Hide Sidebar"
                    );

                    toggleBtn.setAttribute(
                        "aria-label",
                        isHidden ? "Show Sidebar" : "Hide Sidebar"
                    );

                    toggleBtn.setAttribute(
                        "aria-expanded",
                        (!isHidden).toString()
                    );

                });

            }


            // =====================================
            // AJAX START LOADER
            // =====================================

            $(document).ajaxStart(function () {

                $("#globalLoader").css("display", "flex");

            });


            // =====================================
            // AJAX COMPLETE
            // =====================================

            $(document).ajaxStop(function () {

                $("#globalLoader").hide();

            });


            // =====================================
            // NORMAL PAGE NAVIGATION
            // =====================================

            $(document).on("click", "a", function (e) {

                // Ignore new tab / middle click
                if (
                    e.ctrlKey ||
                    e.shiftKey ||
                    e.metaKey ||
                    e.which === 2
                ) {
                    return;
                }

                // Ignore target blank
                if ($(this).attr("target") === "_blank") {
                    return;
                }

                // Ignore download links
                if ($(this).attr("download") !== undefined) {
                    return;
                }

                const href = $(this).attr("href");

                // Ignore invalid links
                if (
                    !href ||
                    href === "#" ||
                    href.startsWith("javascript:") ||
                    href.startsWith("mailto:") ||
                    href.startsWith("tel:")
                ) {
                    return;
                }

                // Ignore Bootstrap controls
                if ($(this).attr("data-bs-toggle")) {
                    return;
                }

                // Show Loader
                $("#globalLoader").css("display", "flex");

            });


            // =====================================
            // FORM SUBMIT LOADER
            // =====================================

            $(document).on("submit", "form", function () {

                // Ignore new tab forms
                if (this.target === "_blank") {
                    return;
                }

                // Ignore selected forms
                if ($(this).is("[data-no-loader]")) {
                    return;
                }

                $("#globalLoader").css("display", "flex");

            });


            // =====================================
            // HIDE LOADER ON PAGE RESTORE
            // =====================================

            window.addEventListener("pageshow", function () {

                $("#globalLoader").hide();

            });


        });

    </script>


    <!-- =====================================
         PAGE SCRIPTS
    ====================================== -->
    @await RenderSectionAsync("Scripts", required: false)


</body>
</html>
